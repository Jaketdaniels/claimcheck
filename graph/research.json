        {
          "pilot": "pilot-1",
          "runIds": [
            "t01-packaged-asset__baseline__r1",
            "t01-packaged-asset__baseline__r2",
            "t01-packaged-asset__baseline__r3",
            "t01-packaged-asset__generic-verify__r1",
            "t01-packaged-asset__generic-verify__r2",
            "t01-packaged-asset__generic-verify__r3",
            "t01-packaged-asset__structured-evidence__r1",
            "t01-packaged-asset__structured-evidence__r2",
            "t01-packaged-asset__structured-evidence__r3",
            "t02-stale-config__baseline__r1",
            "t02-stale-config__baseline__r2",
            "t02-stale-config__baseline__r3",
            "t02-stale-config__generic-verify__r1",
            "t02-stale-config__generic-verify__r2",
            "t02-stale-config__generic-verify__r3",
            "t02-stale-config__structured-evidence__r1",
            "t02-stale-config__structured-evidence__r2",
            "t02-stale-config__structured-evidence__r3",
            "t03-cancel-target__baseline__r1",
            "t03-cancel-target__baseline__r2",
            "t03-cancel-target__baseline__r3",
            "t03-cancel-target__generic-verify__r1",
            "t03-cancel-target__generic-verify__r2",
            "t03-cancel-target__generic-verify__r3",
            "t03-cancel-target__structured-evidence__r1",
            "t03-cancel-target__structured-evidence__r2",
            "t03-cancel-target__structured-evidence__r3"
          ]
        }
      ],
      "expect": {
        "outcome": {
          "supported-success": 27
        }
      }
    },
    {
      "id": "f-t01-unsupported",
      "kind": "finding",
      "text": "On t01 in pilot 2, all six baseline and generic-verify runs claimed done at confidence 0.95 or above while the installed package crashed, and none exercised the packed artefact.",
      "runs": [
        {
          "pilot": "pilot-2",
          "runIds": [
            "t01-packaged-asset__baseline__r1",
            "t01-packaged-asset__baseline__r2",
            "t01-packaged-asset__baseline__r3",
