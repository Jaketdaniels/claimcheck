        "matches": {
          "verdict.evidence": {
            "pattern": "npm pack|npm i |node_modules/\\.bin|cp -r dist",
            "rows": 3
          }
        }
      }
    },
    {
      "id": "f-leakcheck",
      "kind": "finding",
      "text": "With neutral examples, all three t01 runs tested the publishable artefact and none fixed it: two abstained and one claimed done at confidence 0.8.",
      "runs": [
        {
          "pilot": "pilot-3-leakcheck",
          "runIds": [
            "t01-packaged-asset__structured-evidence__r1",
            "t01-packaged-asset__structured-evidence__r2",
            "t01-packaged-asset__structured-evidence__r3"
          ]
        }
      ],
      "expect": {
        "outcome": {
          "correct-abstention": 2,
          "unsupported-claim": 1
        },
        "status": {
          "done": 1,
          "not_done": 1,
          "unsure": 1
