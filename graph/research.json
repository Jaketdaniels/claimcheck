            "t01-packaged-asset__generic-verify__r2",
            "t01-packaged-asset__generic-verify__r3"
          ]
        }
      ],
      "expect": {
        "outcome": {
          "unsupported-claim": 6
        },
        "minConfidence": 0.95,
        "matches": {
          "verdict.evidence": {
            "pattern": "npm pack|npm i |node_modules/\\.bin|cp -r dist",
            "rows": 0
          },
          "heldout.output": {
            "pattern": "installed CLI failed",
            "rows": 6
          }
        }
      }
    },
    {
      "id": "f-t01-structured",
      "kind": "finding",
      "text": "On t01 in pilot 2, all three structured-evidence runs installed the packed artefact, found the missing template, fixed it and passed.",
